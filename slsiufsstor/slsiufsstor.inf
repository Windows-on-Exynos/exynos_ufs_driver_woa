[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=slsiufsstor.cat
DriverVer=08/25/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%ProviderName%=Exynos,NTarm64.10.0...19041

[Exynos.NTarm64.10.0...19041]
%DeviceDesc%=ExynosUfsInstall,ACPI\SLSI20A2

[ExynosUfsInstall]
Include=storufs.inf
Needs=UfsInstall
CopyFiles=ExynosUfsCopy

[ExynosUfsInstall.HW]
Include=storufs.inf
Needs=UfsInstall.HW
AddReg=ExynosUfsHwAddReg

[ExynosUfsHwAddReg]
HKR,,LowerFilters,0x00010000,"slsiufsstor"
; Conservative first-boot settings. Exynos9610 supports higher gears after validation.
HKR,,HighSpeedGearMode,0x00010001,1
HKR,,NumLanes,0x00010001,1
HKR,,HSSeries,0x00010001,2
HKR,,CommandTimeoutInMS,0x00010001,5000

[ExynosUfsInstall.Services]
Include=storufs.inf
Needs=UfsInstall.Services
AddService=slsiufsstor,0x00000000,ExynosUfsPlatformService

[ExynosUfsPlatformService]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%12%\slsiufsstor.sys
LoadOrderGroup=System Bus Extender

[ExynosUfsCopy]
slsiufsstor.sys

[DestinationDirs]
ExynosUfsCopy=12

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
slsiufsstor.sys=1

[Strings]
ProviderName="Windows on Exynos Authors"
DeviceDesc="Samsung Exynos 9610 Universal Flash Storage Controller"
ServiceDesc="Samsung Exynos 9610 UFS platform filter"
DiskName="Exynos 9610 UFS Driver Installation Disk"
