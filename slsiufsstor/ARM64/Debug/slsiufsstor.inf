[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%ManufacturerName%
CatalogFile=slsiufsstor.cat
DriverVer = 07/10/2026,16.31.4.552
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
slsiufsstor.sys  = 1

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NTARM64

[Standard.NTARM64]
%slsiufsstor.DeviceDesc%=slsiufsstor_Device, ACPI\SLSI20A2

[slsiufsstor_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
slsiufsstor.sys

;-------------- Service installation
[slsiufsstor_Device.NT.Services]
AddService = slsiufsstor,%SPSVCINST_ASSOCSERVICE%, slsiufsstor_Service_Inst

; -------------- slsiufsstor driver install sections
[slsiufsstor_Service_Inst]
DisplayName    = %slsiufsstor.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 0               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\slsiufsstor.sys

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="Windows on Exynos Authors"
DiskName = "Exynos UFS Storage Driver Installation Disk"
slsiufsstor.DeviceDesc = "Exynos UFS Storage Driver Device"
slsiufsstor.SVCDESC = "Exynos UFS Storage Driver Service"
